{
  "name": "MSc NGS Bioinformatics",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "postCreateCommand": "mkdir -p /workspaces/variantcalling && ln -sfn /workspaces/variantcalling /home/vscode/variantcalling",

